#include <behaviors.dtsi>
#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define L_BASE  0
#define L_SYM   1
#define L_FUNC  2
#define L_MAGIC 3
#define L_SET   4

/* RGB and output control routed through lrgb_sync; 0x100 and 0x200 mark the
 * two command ranges (see the param1 encoding in
 * config/src/tomahawk56_layer_rgb.c). Output goes through the wrapper rather
 * than binding &out directly so the press itself repaints the active-output
 * key: ZMK only raises zmk_endpoint_changed when the *selected* endpoint moves,
 * so choosing USB while unplugged would otherwise light nothing. */
#define LRGB(cmd) &lrgb_sync (0x100 + (cmd)) 0
#define LOUT(cmd) &lrgb_sync (0x200 + (cmd)) 0

nice_view_spi: &spi0 { cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>; };

&led_strip {
    chain-length = <28>;
};

/ {
    behaviors {
        /* Internal global behavior; node name must fit ZMK's 8-byte BLE field. */
        lrgb_sync: lrgb {
            compatible = "zmk,behavior-layer-rgb-sync";
            #binding-cells = <2>;
        };

        /*
         * Fast opposite-hand chords resolve on the target key's release: F down,
         * J down/up, F up is a layer chord, while the rolling F down, J down,
         * F up, J up sequence remains "fj". Separate behaviors are required
         * because each hand triggers only from positions on the other hand.
         *
         * Four guards, each covering a distinct misfire, all pinned by cases in
         * tests/home-row-layer:
         *
         *   balanced             a chord resolves the moment the target key is
         *                        released, so the tapping term is never the
         *                        thing standing between a chord and its symbol
         *   positional triggers  a same-hand neighbour forces a tap, whether it
         *                        is released early or still held at the term
         *   quick-tap-ms         a doubled letter ("ss", "ll") stays typing even
         *                        when the second press lingers
         *   require-prior-idle   a key pressed mid-burst cannot start a layer
         *
         * The tapping term only governs the one path the guards above cannot
         * reach: the key held alone. It is deliberately long, because the hold
         * is &mo and produces no keycode - a dwell past the term silently eats
         * the letter. Lengthening it costs a chord nothing (that path resolves
         * on release, not on the timer), so it buys reliability for free.
         *
         * NOTE: do not add hold-trigger-on-release here. It defers the
         * positional check to the first key *released*, which leaves the check
         * unarmed when a same-hand neighbour is still held as the term expires
         * - the layer then fires off a same-hand key. Regression: case 6.
         *
         * The hold must stay plain &mo. &lrgb_sync is global-locality, so using it
         * here put a blocking split BLE send on the key-press path. RGB follows the
         * layer via the zmk_layer_state_changed listener instead.
         */
        layer_tap_left: layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                52 53 54 55>;
            bindings = <&mo>, <&kp>;
        };

        layer_tap_right: layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49 50 51>;
            bindings = <&mo>, <&kp>;
        };

        /* Active-layer interruptions cannot force Cmd. */
        cmd_tog: cmd_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <225>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&tog>;
        };

        /*
         * Tab/Ctrl, Bspc/Shift, Enter/Option. Tap-preferred: an interrupting
         * key contributes nothing to the decision, so the timer is the only
         * route to the modifier. Every chord costs the full term, and that is
         * the point - nothing you type can force a modifier.
         *
         * These were tried as balanced, to resolve on the chord key's release
         * the way the home row does. It was reverted from hardware: during a
         * correction burst - tap Bspc, press it again, roll a letter inside
         * that second press - the nested letter came out capitalised after the
         * delete. quick-tap-ms only covers the re-press if it lands inside its
         * window, and in a real burst it often does not. Under tap-preferred
         * that sequence cannot happen at all.
         *
         * No require-prior-idle here on purpose. On Shift, Ctrl or Option it
         * would turn a quick intentional hold right after typing into a stray
         * Bspc, Tab or Enter.
         */
        safe_mt: safe_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Cmd only by holding past the tapping term; interrupting keys never
         * force the modifier, so typing rolls always resolve as Space. The
         * prior-idle guard protects typing rolls while keeping deliberate
         * Cmd holds responsive.
         */
        safe_space_mt: safe_space_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <225>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ZMK_MACRO(lock_screen,
            bindings
                = <&macro_press &kp LCTRL &kp LGUI>
                , <&macro_tap &kp Q>
                , <&macro_release &kp LGUI &kp LCTRL>
                ;
        )

        ZMK_MACRO(sound_prefs,
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp C_VOL_UP>
                , <&macro_release &kp LALT>
                ;
        )

        ZMK_MACRO(screenshot,
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT &kp LGUI>
                ;
        )
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Mirrored bottom-row Escape chords on pairs that almost never roll in
         * prose, isolated from all layer hold-taps.
         */
        escape_left {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <39 40>; /* C + V */
            bindings = <&kp ESC>;
            layers = <L_BASE>;
        };

        escape_right {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <43 44>; /* M + , */
            bindings = <&kp ESC>;
            layers = <L_BASE>;
        };

        /*
         * Settings mode, reachable one-handed from either half: the lower two
         * keys of that half's outer column, squeezed together. Both positions
         * are &none on every layer, so no typing roll can reach the pair and no
         * prior-idle guard is needed; the timeout can stay loose for the same
         * reason. Both halves are local chords - neither crosses the split
         * link. Listed on L_SET as well so the same squeeze toggles back out.
         */
        settings_left {
            timeout-ms = <100>;
            key-positions = <24 36>; /* left of A + left of Z */
            bindings = <&tog L_SET>;
            layers = <L_BASE L_SET>;
        };

        settings_right {
            timeout-ms = <100>;
            key-positions = <35 47>; /* right of ' + right of / */
            bindings = <&tog L_SET>;
            layers = <L_BASE L_SET>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ----------------------------------------------------------------------------------------------------------------
// | NONE |  1  |  2  |   3   |   4   |  5  |        |  6  |  7  |   8   |   9   |  0  | NONE |
// | NONE |  Q  |  W  |   E   |   R   |  T  |        |  Y  |  U  |   I   |   O   |  P  | NONE |
// | SET  |  A  | S/M3| D/M2  | F/M1  |  G  |        |  H  | J/M1| K/M2  | L/M3  |  '  | SET  |
// | SET  |  Z  |  X  |   C   |   V   |  B  |        |  N  |  M  |   ,   |   .   |  /  | SET  |
//              |TAB/C|BSPC/S |SPACE/G|ENTER/A|      |ENTER/A|SPACE/G|BSPC/S|TAB/C |
//
// SET marks the outer pairs that enter Settings; squeeze the two on either half.
// They are dead on their own, and nothing that reboots or reflashes the board
// lives on Base.
//
// Both Space thumbs are Space/Cmd, so the thumb row is a true mirror. Neither
// one repeats spaces by being held - that is a hold now, and it means Cmd. To
// repeat, tap Space and re-press within quick-tap-ms: the second press is
// forced to a tap, and a held &kp does auto-repeat. Pinned by
// tests/space-cmd/5-tap-then-hold-repeat.
            bindings = <
&none        &kp N1  &kp N2                    &kp N3                   &kp N4                  &kp N5       &kp N6  &kp N7                    &kp N8                   &kp N9                  &kp N0                  &none
&none        &kp Q   &kp W                     &kp E                    &kp R                   &kp T        &kp Y   &kp U                     &kp I                    &kp O                   &kp P                   &none
&none        &kp A   &layer_tap_left L_MAGIC S &layer_tap_left L_FUNC D &layer_tap_left L_SYM F &kp G        &kp H   &layer_tap_right L_SYM J &layer_tap_right L_FUNC K &layer_tap_right L_MAGIC L &kp SQT                 &none
&none        &kp Z   &kp X                     &kp C                    &kp V                   &kp B        &kp N   &kp M                     &kp COMMA                &kp DOT                 &kp FSLH                &none
                    &safe_mt LCTRL TAB  &safe_mt LSHFT BSPC  &safe_space_mt LGUI SPACE  &safe_mt LALT ENTER        &safe_mt RALT ENTER  &safe_space_mt RGUI SPACE  &safe_mt RSHFT BSPC  &safe_mt RCTRL TAB
            >;
        };

        symbols_layer {
            display-name = "Symbols";
// ----------------------------------------------------------------------------------------------------------------
// | TRNS |TRNS |TRNS | TRNS | TRNS | TRNS |        | TRNS |TRNS |TRNS |TRNS |TRNS |TRNS |
// | TRNS |  ^  |  /  |  *   |  +   |  \  |        |  =   |  !  |  &  |  |  |  ?  |TRNS |
// | TRNS |  #  |  @  |  _   |  -   |  $   |        |  %   |  :  |  ;  |  ,  |  .  |TRNS |
// | TRNS |  <  |  (  |  [   |  {   |  `   |        |  ~   |  }  |  ]  |  )  |  >  |TRNS |
//              |TRNS |TRNS  |CMD/TOG|TRNS |       |TRNS |CMD/TOG|TRNS |TRNS |
            bindings = <
&trans  &trans     &trans     &trans     &trans      &trans      &trans     &trans      &trans    &trans     &trans  &trans
&trans  &kp CARET  &kp FSLH   &kp STAR   &kp PLUS    &kp BSLH    &kp EQUAL  &kp EXCL    &kp AMPS  &kp PIPE   &kp QMARK &trans
&trans  &kp HASH   &kp AT     &kp UNDER  &kp MINUS   &kp DOLLAR  &kp PRCNT  &kp COLON   &kp SEMI  &kp COMMA  &kp DOT   &trans
&trans  &kp LT     &kp LPAR   &kp LBKT   &kp LBRC    &kp GRAVE   &kp TILDE  &kp RBRC    &kp RBKT  &kp RPAR   &kp GT    &trans
                   &trans  &trans  &cmd_tog LGUI L_SYM  &trans    &trans  &cmd_tog RGUI L_SYM  &trans  &trans
            >;
        };

        functional_layer {
            display-name = "Functional";
// ----------------------------------------------------------------------------------------------------------------
// | F1   | F2       | F3       | F4       | F5       | F6       | F7      | F8       | F9       | F10      | F11      | F12  |
// | NONE | VOL-     | PREV     | PLAY     | NEXT     | VOL+     | BSPC    | OPT+BSPC | OPT+DEL  | DEL      | INSERT   | NONE |
// | NONE | CTRL+UP  | F11      | C+A+ENT  | OPT+CTRL | G+S+V    | LEFT    | DOWN     | UP       | RIGHT    | HOME     | NONE |
// | NONE | G+S+`    | G+S+[    | G+S+]    | G+`      | G+C+SPC  | G+LEFT  | A+LEFT   | A+RIGHT  | G+RIGHT  | END      | NONE |
//                   |TRNS |TRNS |CMD/TOG|TRNS |      |TRNS |CMD/TOG|TRNS |TRNS |
            bindings = <
&kp F1  &kp F2             &kp F3             &kp F4             &kp F5          &kp F6            &kp F7        &kp F8       &kp F9        &kp F10       &kp F11        &kp F12
&none   &kp C_VOL_DN       &kp C_PREV         &kp C_PP           &kp C_NEXT      &kp C_VOL_UP      &kp BSPC      &kp LA(BSPC) &kp LA(DEL)   &kp DEL       &kp INSERT     &none
&none   &kp LC(UP)         &kp F11            &kp LC(LA(ENTER))  &kp LA(LCTRL)  &kp LG(LS(V))     &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT     &kp HOME       &none
&none   &kp LG(LS(GRAVE))  &kp LG(LS(LBKT))   &kp LG(LS(RBKT))  &kp LG(GRAVE)  &kp LG(LC(SPACE)) &kp LG(LEFT)  &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &kp END        &none
                         &trans  &trans  &cmd_tog LGUI L_FUNC  &trans    &trans  &cmd_tog RGUI L_FUNC  &trans  &trans
            >;
        };

        magic_layer {
            display-name = "Magic";
// ----------------------------------------------------------------------------------------------------------------
// | NONE | NONE | NONE  | NONE | NONE | NONE |       | NONE | NONE | NONE | NONE | NONE | NONE |
// | NONE | RGB  | BRI-  | BRI+ | NONE | NONE |       | NONE | MB1  | MB3  | MB2  | NONE | NONE |
// | NONE | LOCK | SOUND | DOCK | SHOT | NONE |       | M<   | Mv   | M^   | M>   | MB4  | NONE |
// | NONE | NONE | NONE  | NONE | NONE | NONE |       | S<   | Sv   | S^   | S>   | MB5  | NONE |
//                    |TRNS |TRNS |CMD/TOG|TRNS |     |TRNS |CMD/TOG|TRNS |TRNS |
//
// RGB stays here on Q/W/E, mirrored on the same positions in Settings. Studio
// unlock and the battery readout moved to the Settings layer.
            bindings = <
&none  &none                 &none                  &none               &none        &none       &none              &none              &none             &none               &none       &none
&none  LRGB(RGB_TOG_CMD)     LRGB(RGB_BRD_CMD)      LRGB(RGB_BRI_CMD)  &none        &none       &none              &mkp MB1           &mkp MB3          &mkp MB2            &none       &none
&none  &lock_screen          &sound_prefs           &kp LG(LA(D))       &screenshot  &none       &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_UP      &mmv MOVE_RIGHT     &mkp MB4   &none
&none  &none                 &none                  &none               &none        &none       &msc SCRL_LEFT     &msc SCRL_DOWN     &msc SCRL_UP      &msc SCRL_RIGHT     &mkp MB5   &none
                            &trans  &trans  &cmd_tog LGUI L_MAGIC  &trans    &trans  &cmd_tog RGUI L_MAGIC  &trans  &trans
            >;
        };

        /*
         * Settings. A latched mode rather than a hold: entered and left with an
         * outer-column squeeze (or any thumb), so both hands are free for
         * multi-tap work like stepping through profiles. Every unused position
         * is &none, not &trans - while the mode is on the board types nothing,
         * so a stray key press cannot do damage, and the RGB map is the legend.
         *
         * &bootloader is event-source local: each half's own key reflashes that
         * half. &ind_bat and &ind_con are global-locality, so pressing them
         * blocks on a split send - fine here, never on Base.
         *
         * No soft reboot key: the power switch on each half already does that.
         */
        settings_layer {
            display-name = "Settings";
// ----------------------------------------------------------------------------------------------------------------
// | BOOT | BT1   | BT2  | BT3  | BT4  | CLR* |     | NONE | NONE | NONE | NONE | NONE  | BOOT |
// |UNLCK | USB   | BLE  | NONE | NONE | NONE |     | NONE | NONE | NONE | NONE | NONE  | NONE |
// | SET  | NONE  | RGB  | BRI- | BRI+ | NONE |     | NONE | NONE | NONE | NONE | NONE  | SET  |
// | SET  | NONE  | NONE | NONE | NONE | BATT |     | NONE | NONE | NONE | NONE | NONE  | SET  |
//               |EXIT |EXIT |EXIT |EXIT |            |EXIT |EXIT |EXIT |EXIT |
//
// * CLR is &bt BT_CLR_ALL: forgets all four pairings at once, the only forget
//   there is. Red, like the bootloader corner at the other end of the row.
//
// The profile keys sit on the number row because the rgbled-widget hunts down
// &bt BT_SEL bindings and puts its own connect/advertise indicator on them,
// using a position-to-pixel formula that only agrees with our LED map on this
// row (see main_pixels in tomahawk56_layer_rgb.c). On the home row its light
// landed on the mirrored key.
//
// Everything else groups by how the key gets used, not by what it is called:
// USB/BLE sit under the Bluetooth row they belong with and light purple on the
// active one; RGB drops to the home row so a slip while walking brightness
// cannot land on a profile switch and drop the connection; battery keeps its
// mnemonic on B. The whole panel is left-handed - the right half is bootloader
// and the way out, nothing else.
            bindings = <
&bootloader     &bt BT_SEL 0   &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_CLR_ALL  &none  &none  &none  &none  &none  &bootloader
&studio_unlock  LOUT(OUT_USB)  LOUT(OUT_BLE)      &none              &none              &none           &none  &none  &none  &none  &none  &none
&none           &none          LRGB(RGB_TOG_CMD)  LRGB(RGB_BRD_CMD)  LRGB(RGB_BRI_CMD)  &none           &none  &none  &none  &none  &none  &none
&none           &none          &none              &none              &none              &ind_bat        &none  &none  &none  &none  &none  &none
                       &to L_BASE  &to L_BASE  &to L_BASE  &to L_BASE        &to L_BASE  &to L_BASE  &to L_BASE  &to L_BASE
            >;
        };
    };
};
