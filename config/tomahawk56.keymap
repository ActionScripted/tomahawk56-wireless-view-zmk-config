#include <behaviors.dtsi>
#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define L_BASE  0
#define L_SYM   1
#define L_FUNC  2
#define L_MAGIC 3

/* RGB control routed through lrgb_sync; 0x100 marks the command range
 * (see the param1 encoding in config/src/tomahawk56_layer_rgb.c). */
#define LRGB(cmd) &lrgb_sync (0x100 + (cmd)) 0

nice_view_spi: &spi0 { cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>; };

&led_strip {
    chain-length = <28>;
};

/ {
    behaviors {
        /* Internal global behavior; node name must fit ZMK's 8-byte BLE field. */
        lrgb_sync: lrgb {
            compatible = "zmk,behavior-layer-rgb-sync";
            #binding-cells = <2>;
        };

        /*
         * Strictly time-based layer holds. A recent key press forces an immediate tap,
         * so neither same-hand nor cross-hand typing rolls can activate a layer.
         */
        layer_tap: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <250>;
            bindings = <&lrgb_sync>, <&kp>;
        };

        /* Active-layer interruptions cannot force Cmd. */
        cmd_tog: cmd_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&tog>;
        };

        /* Thumb interruptions cannot force modifiers. */
        safe_mt: safe_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Cmd only by holding past the tapping term; interrupting keys never
         * force the modifier, so typing rolls always resolve as Space.
         */
        safe_space_mt: safe_space_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ZMK_MACRO(lock_screen,
            bindings
                = <&macro_press &kp LCTRL &kp LGUI>
                , <&macro_tap &kp Q>
                , <&macro_release &kp LGUI &kp LCTRL>
                ;
        )

        ZMK_MACRO(sound_prefs,
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp C_VOL_UP>
                , <&macro_release &kp LALT>
                ;
        )

        ZMK_MACRO(screenshot,
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT &kp LGUI>
                ;
        )
    };

    combos {
        compatible = "zmk,combos";

        /* Mirrored upper-alpha Escape chords, isolated from all layer hold-taps. */
        escape_left {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <15 16>; /* E + R */
            bindings = <&kp ESC>;
            layers = <L_BASE>;
        };

        escape_right {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <19 20>; /* U + I */
            bindings = <&kp ESC>;
            layers = <L_BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ----------------------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |   3   |   4   |  5  |        |  6  |  7  |   8   |   9   |  0  | BOOT |
// |RESET |  Q  |  W  |   E   |   R   |  T  |        |  Y  |  U  |   I   |   O   |  P  | NONE |
// | NONE |  A  | S/M3| D/M2  | F/M1  |  G  |        |  H  | J/M1| K/M2  | L/M3  |  '  | NONE |
// | NONE |  Z  |  X  |   C   |   V   |  B  |        |  N  |  M  |   ,   |   .   |  /  | NONE |
//              |TAB/C|BSPC/S |SPACE/G|ENTER/A|      |ENTER/A|SPACE/G|BSPC/S|TAB/C |
            bindings = <
&bootloader  &kp N1  &kp N2                    &kp N3                   &kp N4                  &kp N5       &kp N6  &kp N7                    &kp N8                   &kp N9                  &kp N0                  &bootloader
&sys_reset   &kp Q   &kp W                     &kp E                    &kp R                   &kp T        &kp Y   &kp U                     &kp I                    &kp O                   &kp P                   &none
&none        &kp A   &layer_tap L_MAGIC S      &layer_tap L_FUNC D      &layer_tap L_SYM F      &kp G        &kp H   &layer_tap L_SYM J        &layer_tap L_FUNC K      &layer_tap L_MAGIC L    &kp SQT                 &none
&none        &kp Z   &kp X                     &kp C                    &kp V                   &kp B        &kp N   &kp M                     &kp COMMA                &kp DOT                 &kp FSLH                &none
                    &safe_mt LCTRL TAB  &safe_mt LSHFT BSPC  &safe_space_mt LGUI SPACE  &safe_mt LALT ENTER        &safe_mt RALT ENTER  &safe_space_mt RGUI SPACE  &safe_mt RSHFT BSPC  &safe_mt RCTRL TAB
            >;
        };

        symbols_layer {
            display-name = "Symbols";
// ----------------------------------------------------------------------------------------------------------------
// | TRNS |TRNS |TRNS | TRNS | TRNS | TRNS |        | TRNS |TRNS |TRNS |TRNS |TRNS |TRNS |
// | TRNS |  ^  |  /  |  *   |  +   |  \  |        |  =   |  !  |  &  |  |  |  ?  |TRNS |
// | TRNS |  #  |  @  |  _   |  -   |  $   |        |  %   |  :  |  ;  |  ,  |  .  |TRNS |
// | TRNS |  <  |  (  |  [   |  {   |  `   |        |  ~   |  }  |  ]  |  )  |  >  |TRNS |
//              |TRNS |TRNS  |CMD/TOG|TRNS |       |TRNS |CMD/TOG|TRNS |TRNS |
            bindings = <
&trans  &trans     &trans     &trans     &trans      &trans      &trans     &trans      &trans    &trans     &trans  &trans
&trans  &kp CARET  &kp FSLH   &kp STAR   &kp PLUS    &kp BSLH    &kp EQUAL  &kp EXCL    &kp AMPS  &kp PIPE   &kp QMARK &trans
&trans  &kp HASH   &kp AT     &kp UNDER  &kp MINUS   &kp DOLLAR  &kp PRCNT  &kp COLON   &kp SEMI  &kp COMMA  &kp DOT   &trans
&trans  &kp LT     &kp LPAR   &kp LBKT   &kp LBRC    &kp GRAVE   &kp TILDE  &kp RBRC    &kp RBKT  &kp RPAR   &kp GT    &trans
                   &trans  &trans  &cmd_tog LGUI L_SYM  &trans    &trans  &cmd_tog RGUI L_SYM  &trans  &trans
            >;
        };

        functional_layer {
            display-name = "Functional";
// ----------------------------------------------------------------------------------------------------------------
// | F1   | F2       | F3       | F4       | F5       | F6       | F7      | F8       | F9       | F10      | F11      | F12  |
// | NONE | VOL-     | PREV     | PLAY     | NEXT     | VOL+     | BSPC    | OPT+BSPC | OPT+DEL  | DEL      | INSERT   | NONE |
// | NONE | CTRL+UP  | F11      | C+A+ENT  | OPT+CTRL | G+S+V    | LEFT    | DOWN     | UP       | RIGHT    | HOME     | NONE |
// | NONE | G+S+`    | G+S+[    | G+S+]    | G+`      | G+C+SPC  | G+LEFT  | A+LEFT   | A+RIGHT  | G+RIGHT  | END      | NONE |
//                   |TRNS |TRNS |CMD/TOG|TRNS |      |TRNS |CMD/TOG|TRNS |TRNS |
            bindings = <
&kp F1  &kp F2             &kp F3             &kp F4             &kp F5          &kp F6            &kp F7        &kp F8       &kp F9        &kp F10       &kp F11        &kp F12
&none   &kp C_VOL_DN       &kp C_PREV         &kp C_PP           &kp C_NEXT      &kp C_VOL_UP      &kp BSPC      &kp LA(BSPC) &kp LA(DEL)   &kp DEL       &kp INSERT     &none
&none   &kp LC(UP)         &kp F11            &kp LC(LA(ENTER))  &kp LA(LCTRL)  &kp LG(LS(V))     &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT     &kp HOME       &none
&none   &kp LG(LS(GRAVE))  &kp LG(LS(LBKT))   &kp LG(LS(RBKT))  &kp LG(GRAVE)  &kp LG(LC(SPACE)) &kp LG(LEFT)  &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &kp END        &none
                         &trans  &trans  &cmd_tog LGUI L_FUNC  &trans    &trans  &cmd_tog RGUI L_FUNC  &trans  &trans
            >;
        };

        magic_layer {
            display-name = "Magic";
// ----------------------------------------------------------------------------------------------------------------
// | NONE | NONE | NONE  | NONE | NONE | NONE |       | NONE | NONE | NONE | NONE | NONE | NONE |
// | NONE | RGB  | BRI-  | BRI+ | NONE | NONE |       | NONE | MB1  | MB3  | MB2  | NONE | NONE |
// | NONE | LOCK | SOUND | DOCK | SHOT | NONE |       | M<   | Mv   | M^   | M>   | MB4  | NONE |
// | NONE | NONE | NONE  | NONE | NONE | BAT  |       | S<   | Sv   | S^   | S>   | MB5  | NONE |
//                    |TRNS |TRNS |CMD/TOG|TRNS |     |TRNS |CMD/TOG|TRNS |TRNS |
            bindings = <
&none  &none                 &none                  &none               &none        &none       &none              &none              &none             &none               &none       &none
&none  LRGB(RGB_TOG_CMD)     LRGB(RGB_BRD_CMD)      LRGB(RGB_BRI_CMD)  &none        &none       &none              &mkp MB1           &mkp MB3          &mkp MB2            &none       &none
&none  &lock_screen          &sound_prefs           &kp LG(LA(D))       &screenshot  &none       &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_UP      &mmv MOVE_RIGHT     &mkp MB4   &none
&none  &none                 &none                  &none               &none        &ind_bat    &msc SCRL_LEFT     &msc SCRL_DOWN     &msc SCRL_UP      &msc SCRL_RIGHT     &mkp MB5   &none
                            &trans  &trans  &cmd_tog LGUI L_MAGIC  &trans    &trans  &cmd_tog RGUI L_MAGIC  &trans  &trans
            >;
        };
    };
};
