menuconfig TOMAHAWK56_LAYER_RGB
    bool "Tomahawk56 per-key layer lighting"
    default y
    depends on ZMK_RGB_UNDERGLOW
    help
      Use the Tomahawk56's 28 addressable LEDs as a persistent per-key
      layer map with Dygma Defy-inspired colors.

config TOMAHAWK56_STUDIO_RESET_ON_FLASH
    bool "Drop the saved ZMK Studio keymap when new firmware is flashed"
    default y
    depends on ZMK_KEYMAP_SETTINGS_STORAGE
    help
      Drop ZMK Studio bindings on the first boot of each newly built image.
      Studio stores bindings outside the firmware image and reapplies them
      over the compiled keymap. Bluetooth pairings and other settings remain.
