#include "../behavior_keymap.dtsi"

/*
 * A deliberate chord started 155 ms in - short of the 175 ms term. It must
 * produce the symbol on the target's press, before the timer can resolve it.
 */
&kscan {
    events = <
        ZMK_MOCK_PRESS(0,0,155)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,30)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
