#include "../behavior_keymap.dtsi"

/*
 * The originally reported misfire, which produced "fj". The layer key down,
 * target down/up, layer key up sequence must resolve to the target's symbol
 * without waiting out the tapping term at all. (Which symbol is a property of
 * the Symbols layer, not of this behavior; the test layer here uses MINUS as a
 * stand-in.)
 */
&kscan {
    events = <
        ZMK_MOCK_PRESS(0,0,30)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,30)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
