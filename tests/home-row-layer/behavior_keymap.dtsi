/*
 * Small layout for isolated layer decisions. The hand names in older case
 * paths describe the gesture; the production behaviors now allow either hand.
 */

#include "../hold-taps.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &layer_tap_left 1 S &kp A
                &kp C &kp D>;
        };

        test_layer {
            bindings = <
                &trans &kp MINUS
                &kp D &trans>;
        };
    };
};
