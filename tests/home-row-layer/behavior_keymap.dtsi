/*
 * Mirror of layer_tap_left/layer_tap_right from config/tomahawk56.keymap. The
 * two production behaviors differ only in which half's positions they list, so
 * one behavior with a single opposite-hand trigger key stands in for both:
 * position 1 is "the other hand", positions 2 and 3 are "this hand".
 *
 * Keep every timing here identical to the production node. A drifted mirror
 * makes the suite pass while describing a keyboard that does not exist.
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        hr: home_row_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <1>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &hr 1 S &kp A
                &kp C &kp D>;
        };

        test_layer {
            bindings = <
                &trans &kp MINUS
                &kp D &trans>;
        };
    };
};
