/*
 * Mirror of safe_space_mt from config/tomahawk56.keymap: Space on tap,
 * Cmd (LGUI) only by holding past the tapping term.
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        spc: safe_space_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <450>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &spc LGUI SPACE &kp A
                &kp B &kp C>;
        };
    };
};
