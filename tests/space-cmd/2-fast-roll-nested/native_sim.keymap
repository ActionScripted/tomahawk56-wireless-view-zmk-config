#include "../behavior_keymap.dtsi"

/*
 * Nested roll: A pressed AND released while space is still down. This is the
 * sequence the old "balanced" flavor turned into Cmd+A. Must be "space a".
 */
&kscan {
    events = <
        ZMK_MOCK_PRESS(0,0,30)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,30)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
